# ---- Services (required) --------------------------------------------------------------------
DEEPGRAM_API_KEY=
MURF_API_KEY=
# The key for whichever OpenAI-compatible API you point OPENAI_BASE_URL at. With the Groq
# default below, this is your Groq key (console.groq.com/keys).
OPENAI_API_KEY=

# ---- Service defaults (optional) ------------------------------------------------------------
# Groq by default: an OpenAI-compatible API with a free tier, and fast enough to keep replies
# inside a second. Model ids change often, so set whichever fast chat model your account has.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b

# For OpenAI itself, or anything else that speaks the same API:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.2-mini

# MURF_VOICE=en-US-natalie

# What the caller speaks, as a Deepgram language code that nova-3 supports: en-IN, hi, bn, gu,
# kn, mr, pa, ta, te, ur, or `multi` for speech that switches between English and another.
# STT_LANGUAGE=en

# Default instructions for the model. The page can override it per call.
# SYSTEM_PROMPT=You are a voice assistant in a live phone-style conversation. Reply in one or two short sentences.

# ---- Server ---------------------------------------------------------------------------------
# Listen address. Keep 127.0.0.1 behind a reverse proxy; 0.0.0.0 to accept connections directly.
# ADDR=127.0.0.1:8080

# Required on every call when set. Set this whenever the server is reachable by anyone else:
# each call spends your Deepgram, model and Murf credit.
# ACCESS_TOKEN=

# Concurrent calls, and the longest a single call may run.
# MAX_CALLS=10
# MAX_CALL_SECS=1800

# Lets the page send OPENAI_API_KEY to an endpoint of its choosing. Leave off in production.
# ALLOW_BASE_URL_OVERRIDE=false

# error | warn | info | debug | trace
# LOG_LEVEL=info

# ---- WebRTC networking (needed on cloud hosts and behind firewalls) --------------------------
# The address browsers should send media to. On a cloud VM this is its public IP.
# PUBLIC_IP=203.0.113.10
# Local address to bind media sockets to. Defaults to the default-route interface.
# RTC_BIND_IP=
# One UDP port per call; open this range in the firewall. Must hold at least MAX_CALLS ports.
# RTC_PORT_MIN=40000
# RTC_PORT_MAX=40099

# ---- Testing against the mocks in examples/ -------------------------------------------------
# DEEPGRAM_URL=ws://127.0.0.1:9999/v1/listen
# OPENAI_BASE_URL=http://127.0.0.1:9998/v1
# MURF_URL=ws://127.0.0.1:9997/v1/speech/stream-input
